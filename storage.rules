rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /activity-photos/{activityId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'photo_committee'];
    }

    match /profile-photos/{memberId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == memberId || request.auth.token.role in ['admin', 'board']);
    }

    match /sepa/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.role in ['admin', 'board'];
    }
  }
}
