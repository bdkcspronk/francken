rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function inRoles(roles) {
      return signedIn() && role() in roles;
    }

    function isAdminOrBoard() {
      return inRoles(['admin', 'board']);
    }

    function isTreasurer() {
      return inRoles(['committee_treasurer', 'admin', 'board']);
    }

    function isPhotoCommittee() {
      return inRoles(['photo_committee', 'admin']);
    }

    function isOwner(memberId) {
      return signedIn() && request.auth.uid == memberId;
    }

    match /members/{memberId} {
      allow read: if isOwner(memberId) || isAdminOrBoard();
      allow create: if signedIn();
      allow update: if isOwner(memberId) || isAdminOrBoard();
      allow delete: if inRoles(['admin']);
    }

    match /committees/{id} {
      allow read: if true;
      allow write: if isAdminOrBoard();
    }

    match /board/{id} {
      allow read: if true;
      allow write: if isAdminOrBoard();
    }

    match /activities/{id} {
      allow read: if true;
      allow write: if isAdminOrBoard();
    }

    match /activity_signups/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.member_id == request.auth.uid;
      allow update, delete: if isAdminOrBoard() || request.auth.uid == resource.data.member_id;
    }

    match /food_drinks/{id} {
      allow read: if signedIn();
      allow write: if isAdminOrBoard();
    }

    match /food_drink_orders/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdminOrBoard();
      allow delete: if isAdminOrBoard();
    }

    match /merchandise/{id} {
      allow read: if signedIn();
      allow write: if isAdminOrBoard();
    }

    match /merchandise_orders/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdminOrBoard();
    }

    match /invoices/{id} {
      allow read: if signedIn() && (resource.data.member_id == request.auth.uid || isAdminOrBoard());
      allow create, update, delete: if isAdminOrBoard();
    }

    match /invoice_items/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminOrBoard();
    }

    match /second_hand_books/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdminOrBoard() || request.auth.uid == resource.data.seller_member_id || request.auth.uid == request.resource.data.buyer_member_id;
      allow delete: if isAdminOrBoard();
    }

    match /photos/{id} {
      allow read: if true;
      allow create, update, delete: if isPhotoCommittee();
    }

    match /batch_invoices/{id} {
      allow read, write: if isAdminOrBoard();
    }

    match /committee_budgets/{id} {
      allow read: if isTreasurer() || isAdminOrBoard();
      allow create, update: if isTreasurer();
      allow delete: if isAdminOrBoard();
    }

    match /committee_budget_items/{id} {
      allow read: if isTreasurer() || isAdminOrBoard();
      allow write: if isTreasurer() || isAdminOrBoard();
    }
  }
}
